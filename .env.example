# Sepolia RPC URL — get a free one at https://www.alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Private key of the deployer wallet (without 0x prefix)
# Never commit your real private key — use a dedicated deploy wallet
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification (optional)
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_key_here
